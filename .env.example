# ── Supabase (client-side, safe to expose in the browser) ──────────────────
# Anon/publishable key — protected by Row Level Security, not a secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Supabase (server-side only — used by src/*.server.ts and server functions) ─
# Mirrors of the values above, read via process.env for SSR contexts.
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=

# Service-role key — bypasses Row Level Security entirely.
# NEVER prefix this with VITE_, never import it in client code, never commit it.
# Used only in src/integrations/supabase/client.server.ts for the public
# equipment catalog and availability endpoints.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI (server-side only — used by src/lib/ai.functions.ts) ────────────────
# NEVER prefix this with VITE_. The key is read with process.env and the
# OpenAI call happens inside a createServerFn handler, so it never reaches
# the browser bundle.
OPENAI_API_KEY=
